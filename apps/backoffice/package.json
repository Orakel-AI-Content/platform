{
  "name": "@orakel/backoffice",
  "version": "0.0.0",
  "private": true,
  "description": "Backoffice da Plataforma Orakel AI: conteúdo, configuração dos sites, revisão, publicação e API de exportação",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/apps/backoffice/server.js",
    "worker": "node --env-file-if-exists=../../.env.local src/bin/worker.ts",
    "build-runner": "node --env-file-if-exists=../../.env.local src/bin/build-runner.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local src/bin/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env.local src/bin/seed.ts",
    "media:reprocess": "node --env-file-if-exists=../../.env.local src/bin/reprocess-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@next/env": "catalog:",
    "@orakel/build-contract": "workspace:*",
    "@orakel/content-model": "workspace:*",
    "@orakel/core": "workspace:*",
    "@orakel/tokens": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@sentry/node": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-bold": "catalog:",
    "@tiptap/extension-code": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-italic": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "class-variance-authority": "catalog:",
    "classnames": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "graphile-worker": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-icons": "catalog:",
    "react-modal": "catalog:",
    "sharp": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@orakel/eslint-config": "workspace:*",
    "@orakel/tsconfig": "workspace:*",
    "@orakel/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-modal": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
