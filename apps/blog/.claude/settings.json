{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build:examples)",
      "Bash(pnpm test:a11y)",
      "Bash(pnpm test:parity)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec astro check*)"
    ],
    "deny": [
      "Read(../../**/.env)",
      "Read(../../**/.env.local)",
      "Read(../../**/.env.*.local)",
      "Edit(../../**/.env)",
      "Edit(../../**/.env.local)",
      "Read(./**/coverage/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "additionalDirectories": [
      "../../packages/content-model",
      "../../packages/content-client",
      "../../packages/core",
      "../../packages/tokens",
      "../../packages/events"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../../.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
