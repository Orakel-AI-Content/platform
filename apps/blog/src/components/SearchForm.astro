---
// Caixa de busca: formulário GET para /busca/ (?q=), sem JavaScript. A página de busca
// carrega a UI do Pagefind e dispara a consulta.
import { SEARCH_PATH } from '@orakel/core/v1';

import type { PageContext } from '../data/site-source.ts';
import { sitePath } from '../render/links.ts';
import Icon from './icons/Icon.astro';

interface Props {
  ctx: PageContext;
  class?: string;
}
const { ctx, class: className } = Astro.props;
---

<form
  class:list={['search', className]}
  role="search"
  action={sitePath(ctx.base, SEARCH_PATH)}
  method="get"
>
  <label>
    <span class="sr-only">Buscar no site</span>
    <input type="search" name="q" placeholder="Buscar" autocomplete="off" />
  </label>
  <button type="submit">
    <Icon name="search" />
    <span class="sr-only">Buscar</span>
  </button>
</form>

<style>
  .search {
    display: flex;
    gap: var(--space-2);
  }
  input {
    min-height: 44px;
    min-width: 0;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
  }
  button {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    cursor: pointer;
  }
</style>
