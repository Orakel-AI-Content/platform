---
// Imagem da mídia do site: <picture> com um <source> por formato do perfil (AVIF antes de
// WebP) e srcset por largura; width/height do original evitam CLS. A imagem principal da
// página vai com fetchpriority="high" e sem lazy.
import type { Media, SiteConfig } from '@orakel/content-model/v1';
import { mediaUrl } from '@orakel/core/v1';

import { fallbackVariant, pictureFormats } from '../render/image.ts';

interface Props {
  media: Media;
  config: Pick<SiteConfig, 'domains'>;
  /** Texto alternativo; string vazia marca a imagem como decorativa. */
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}
const { media, config, alt, sizes, priority = false, class: className } = Astro.props;

const formats = pictureFormats(media);
const srcset = (format: string) =>
  media.variants
    .filter((variant) => variant.format === format)
    .sort((a, b) => a.width - b.width)
    .map((variant) => `${mediaUrl(config, variant.path)} ${variant.width}w`)
    .join(', ');
const fallback = fallbackVariant(media);
---

<picture class={className}>
  {formats.map((format) => (
    <source type={`image/${format}`} srcset={srcset(format)} sizes={sizes} />
  ))}
  <img
    src={fallback ? mediaUrl(config, fallback.path) : undefined}
    alt={alt}
    width={media.width}
    height={media.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>

<style>
  picture,
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  img {
    border-radius: inherit;
    background: var(--color-surface);
  }
</style>
