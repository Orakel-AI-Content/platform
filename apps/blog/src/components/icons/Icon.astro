---
// Sempre decorativo: o texto do controle vem ao lado (visível ou .sr-only).
import { ICONS, type IconName } from './paths.ts';

interface Props {
  name: IconName;
}
const { name } = Astro.props;
---

<svg
  class="icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
    vertical-align: -0.25em;
  }
</style>
