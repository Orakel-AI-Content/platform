---
// Cabeçalho: nome do site, navegação do menu `principal` e busca (formulário GET, sem JS).
// No celular, a navegação fica num <details> (degrau 1); o <ok-menu> do elements fecha com
// Esc e com clique fora (degrau 2).
import type { PageContext } from '../data/site-source.ts';
import { sitePath } from '../render/links.ts';
import { searchEnabled } from '../routing/resolve.ts';
import Icon from './icons/Icon.astro';
import SearchForm from './SearchForm.astro';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { config, menus } = ctx.site;
const items = menus.find((menu) => menu.key === 'principal')?.items ?? [];
const search = searchEnabled(config);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={sitePath(ctx.base, '/')}>
      {config.name}
    </a>
    {items.length > 0 && (
      <nav class="nav-wide" aria-label="Principal">
        <ul>
          {items.map((item) => (
            <li>
              <a href={sitePath(ctx.base, item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {search && <SearchForm ctx={ctx} class="search-wide" />}
    {(items.length > 0 || search) && (
      <ok-menu class="nav-narrow">
        <details>
          <summary>
            <Icon name="menu" />
            <span>Menu</span>
          </summary>
          <div class="panel">
            {items.length > 0 && (
              <nav aria-label="Principal (menu)">
                <ul>
                  {items.map((item) => (
                    <li>
                      <a href={sitePath(ctx.base, item.href)}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {search && <SearchForm ctx={ctx} />}
          </div>
        </details>
      </ok-menu>
    )}
  </div>
</header>

<script>
  import '@orakel/elements/menu';
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .brand {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-inline-end: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-wide,
  .search-wide {
    display: none;
  }
  .nav-narrow summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
  }
  .nav-narrow summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .panel ul {
    flex-direction: column;
  }
  .nav-narrow:has(details[open]) {
    flex-basis: 100%;
  }
  ok-menu {
    display: block;
  }
  /* Breakpoint 40rem (src/styles/layout.css). */
  @media (min-width: 40rem) {
    .nav-wide,
    .search-wide {
      display: block;
    }
    .nav-narrow {
      display: none;
    }
  }
</style>
