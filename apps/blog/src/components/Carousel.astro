---
// Carrossel: rolagem nativa com scroll-snap, focável pelo teclado (degrau 1). O
// <ok-carousel> do elements mostra os botões de anterior e próximo (degrau 2); sem JS,
// eles continuam ocultos e a trilha continua rolando.
import Icon from './icons/Icon.astro';

interface Props {
  label: string;
  /** Único na página: liga os botões à trilha (aria-controls). */
  id: string;
}
const { label, id } = Astro.props;
---

<section class="carousel" aria-label={label}>
  <ok-carousel>
    <ul class="track" id={id} tabindex="0" data-ok-track>
      <slot />
    </ul>
    <div class="controls">
      <button type="button" data-ok-prev hidden>
        <Icon name="chevron-left" />
        <span class="sr-only">Anterior</span>
      </button>
      <button type="button" data-ok-next hidden>
        <Icon name="chevron-right" />
        <span class="sr-only">Próximo</span>
      </button>
    </div>
  </ok-carousel>
</section>

<script>
  import '@orakel/elements/carousel';
</script>

<style>
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 20rem);
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 var(--space-3);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scroll-padding-inline: var(--space-1);
  }
  .track > :global(li) {
    scroll-snap-align: start;
  }
  ok-carousel {
    display: block;
  }
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  .controls button {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .controls button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .controls button[hidden] {
    display: none;
  }
</style>
