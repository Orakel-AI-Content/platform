---
// Rodapé: menu `rodape` (se houver), páginas institucionais com texto, feed RSS.
import { institutionalPages } from '@orakel/core/v1';

import type { PageContext } from '../data/site-source.ts';
import { sitePath } from '../render/links.ts';
import Icon from './icons/Icon.astro';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { config, menus } = ctx.site;
const footerMenu = menus.find((menu) => menu.key === 'rodape')?.items ?? [];
const institutional = institutionalPages(ctx.site)
  .filter((page) => !footerMenu.some((item) => item.href === page.path))
  .map((page) => ({ label: page.title, href: page.path }));
const links = [...footerMenu, ...institutional];
---

<footer class="site-footer">
  <div class="container inner">
    {links.length > 0 && (
      <nav aria-label="Rodapé">
        <ul>
          {links.map((item) => (
            <li>
              <a href={sitePath(ctx.base, item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <p class="meta">
      <a href={sitePath(ctx.base, '/rss.xml')}>
        <Icon name="rss" /> <span>Feed RSS</span>
      </a>
      <span>{config.name}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
