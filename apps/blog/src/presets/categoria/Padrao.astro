---
// Listagem `padrao` (categoria, tag, série): cabeçalho simples e lista.
import { taxonomyPath } from '@orakel/core/v1';

import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import type { PresetProps } from '../types.ts';

type Props = PresetProps<'taxonomy'>;
const { ctx, model } = Astro.props;
const { taxonomy } = model;
const variant = ctx.site.config.variants.articleCard;
---

<header class="intro">
  <h1>{taxonomy.name}</h1>
  {taxonomy.description && <p>{taxonomy.description}</p>}
</header>
<ul class="list">
  {model.items.map((content) => (
    <li>
      <ArticleCard ctx={ctx} content={content} variant={variant} />
    </li>
  ))}
</ul>
{model.items.length === 0 && <p>Nenhum artigo aqui ainda.</p>}
<Pagination
  base={ctx.base}
  page={model.page}
  totalPages={model.totalPages}
  pathFor={(page) => taxonomyPath(taxonomy, page)}
/>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-4);
  }
  .list {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
