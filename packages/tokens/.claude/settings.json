{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec tsc *)"
    ],
    "deny": [
      "Read(../../**/.env)",
      "Read(../../**/.env.local)",
      "Read(../../**/.env.*.local)",
      "Edit(../../**/.env)",
      "Edit(../../**/.env.local)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Edit(./dist/**)",
      "Write(./dist/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../../.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
