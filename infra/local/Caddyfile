# Substituto local do Cloudflare Tunnel + Access (ADR 0008 da raiz; ADR 0004 do backoffice).
# Certificados da CA interna do Caddy: instale a raiz uma vez (docs/guides/local-setup.md).
{
	local_certs
	# Certificados sob demanda (sites) só para nomes .localhost: o Caddy pergunta ao bloco
	# :5555 abaixo antes de emitir.
	on_demand_tls {
		ask http://localhost:5555/ask
	}
}

# Autorização dos certificados sob demanda; só escuta dentro do container.
http://localhost:5555 {
	bind 127.0.0.1
	@local expression `{query.domain}.endsWith('.localhost')`
	respond @local 200
	respond 403
}

# Host interno atrás do Access (import protected <upstream>): login, callback e JWKS do
# access-mock no mesmo caminho do Access real; o resto passa pelo forward_auth. Os dois ficam
# em blocos handle separados — fora deles, o forward_auth rodaria antes e prenderia o login.
(protected) {
	handle /cdn-cgi/access/* {
		reverse_proxy access-mock:8788
	}
	handle {
		forward_auth access-mock:8788 {
			uri /cdn-cgi/access/authorize
			copy_headers Cf-Access-Jwt-Assertion
		}
		reverse_proxy {args[0]}
	}
}

admin.orakel.localhost {
	# A API de exportação e a interna só existem na rede dos containers.
	handle /api/export/* {
		respond 404
	}
	handle /api/internal/* {
		respond 404
	}
	import protected {$BACKOFFICE_UPSTREAM}
}

# Visualização dos sites (blog-preview, SSR): /<site>/<caminho>. BLOG_PREVIEW_UPSTREAM aponta
# para o `pnpm --filter @orakel/blog preview` na máquina, se preciso (host.docker.internal).
preview.orakel.localhost {
	import protected {$BLOG_PREVIEW_UPSTREAM}
}

# Console do armazenamento (SeaweedFS, weed admin).
s3.orakel.localhost {
	import protected s3-admin:23646
}

# Perfil observability: erros (GlitchTip) e heartbeats (Healthchecks).
glitchtip.orakel.localhost {
	import protected glitchtip:8000
}

hc.orakel.localhost {
	import protected healthchecks:8000
}

# Perfil lighthouse: relatórios do Lighthouse CI.
lhci.orakel.localhost {
	import protected lhci-server:9001
}

# Sites publicados no edge-local (substituto da Cloudflare): <site>.localhost, público como
# em produção. Bloco genérico (qualquer host que os de cima não atendem), com certificado por
# site emitido no primeiro acesso: com o endereço *.localhost, o Caddy emitiria um curinga, e o
# Chrome recusa curinga logo abaixo do domínio de topo (ERR_CERT_AUTHORITY_INVALID).
https:// {
	tls internal {
		on_demand
	}

	# Mídia dos sites (ADR 0013 da raiz): media.<site>.localhost → bucket media-<site>, pelo
	# filer do SeaweedFS (sem leitura anônima no S3). Só leitura, com o cache do R2 de produção.
	# Pelo formato do nome, sem lista de hosts: site novo não precisa de configuração aqui.
	# media-originals é privado, não é mídia de site.
	@media expression `{host}.matches('^media\\.[a-z0-9-]+\\.localhost$') && {labels.1} != 'originals'`
	handle @media {
		@read method GET HEAD
		handle @read {
			rewrite * /buckets/media-{labels.1}{uri}
			reverse_proxy s3:8888 {
				header_down Cache-Control "public, max-age=31536000, immutable"
			}
		}
		respond 405
	}

	handle {
		reverse_proxy edge-local:8080
	}
}
