# Variáveis que mudam entre local e produção (ADR 0008). Fora delas, os dois
# ambientes se comportam igual. Copie para .env.local (fora do Git):
#
#   cp .env.example .env.local
#
# Os nomes seguem a entrada do scaffold e ainda são *proposta* (docs/project-spec.yaml).
# Cada unidade valida as que usa em src/env.ts (Zod) e falha no boot se faltar alguma.

# --- Postgres (compose) -----------------------------------------------------------
# Acréscimo do scaffold: a senha muda entre local e produção.
POSTGRES_USER=orakel
POSTGRES_PASSWORD=orakel-local
POSTGRES_DB=orakel

# --- Backoffice ------------------------------------------------------------------------
DATABASE_URL=postgres://orakel:orakel-local@localhost:5432/orakel
# Tokens internos (bearer), um por consumidor. Local: qualquer valor com 32+ caracteres.
EXPORT_BUILD_TOKEN=local-build-token-0000000000000000
EXPORT_PREVIEW_TOKEN=local-preview-token-00000000000000
GENERATOR_TOKEN=local-generator-token-0000000000000
# Visualização SSR dos sites, aberta em iframe na tela de revisão (/<site>/<caminho>).
PREVIEW_BASE_URL=https://preview.orakel.localhost

# --- Cloudflare Access (Backoffice) ------------------------------------------------
# Local: access-mock (infra/local/access-mock), com o mesmo contrato do Access.
ACCESS_TEAM_DOMAIN=orakel-local.cloudflareaccess.com
ACCESS_JWKS_URL=http://localhost:8788/cdn-cgi/access/certs
ACCESS_AUD=orakel-local-aud

# --- Armazenamento S3 ---------------------------------------------------------------
# Local: SeaweedFS do compose. Produção: provedor a definir no primeiro deploy.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=orakel-local
S3_SECRET_ACCESS_KEY=orakel-local-secret

# --- Sites (apps/blog) -------------------------------------------------------------
# CONTENT_SOURCE é sempre explícito: api (backoffice) ou fixture (content-model).
CONTENT_SOURCE=fixture
SITE_ID=exemplo-a
EXPORT_API_URL=http://localhost:3000
# SNAPSHOT_META_FILE=/caminho/absoluto/meta.json   (o render do site-builder define)
# preview.orakel.localhost vai para o container blog-preview. Para o `pnpm --filter
# @orakel/blog preview` na máquina, descomente e recrie o caddy (infra/local/compose.sh up -d caddy):
# BLOG_PREVIEW_UPSTREAM=host.docker.internal:4321

# --- Ambiente local (infra/local) -----------------------------------------------------
# admin.orakel.localhost vai para o container backoffice-web. Para o `next dev` na máquina,
# descomente e recrie o caddy (infra/local/compose.sh up -d caddy):
# BACKOFFICE_UPSTREAM=host.docker.internal:3000
# Grupo do socket do Docker no host (0 no Docker Desktop; o gid do grupo docker no Linux).
DOCKER_SOCKET_GID=0
# ClickHouse (Analytics Engine local; o ae-sim do edge-local grava aqui).
CLICKHOUSE_USER=orakel
CLICKHOUSE_PASSWORD=orakel-local

# --- Deploy e imagens -----------------------------------------------------------------
DEPLOY_TARGET=local
IMAGE_REGISTRY=ghcr.io/orakel-ai-content
# Janela de agrupamento dos builds, em segundos (produção: 900).
BUILD_WINDOW_SECONDS=30
# Limite diário de publicações por site, no dia de America/Sao_Paulo (padrão 3); um site
# pode ter o próprio.
PUBLISH_DAILY_LIMIT=3
# Só no E2E: liga a página /teste-de-erro do Backoffice, que lança erro de propósito. O
# backoffice-web do compose local já a liga; descomente só para o E2E contra o `next dev`.
# Nunca em produção.
# E2E_ERROR_ROUTE=1
# Só com DEPLOY_TARGET=cloudflare (produção): o build-runner os repassa ao container publish.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Analytics Engine (SQL) -------------------------------------------------------
# Local: o ClickHouse do compose, com a mesma SQL do AE (ADR 0014 da raiz).
AE_SQL_TRANSPORT=clickhouse
AE_SQL_URL=http://localhost:8123

# --- Backup, monitoramento e qualidade ----------------------------------------------
BR_BACKUP_ENDPOINT=
HEARTBEAT_BASE_URL=
# Vazio desliga o Sentry. Com o perfil observability: o DSN de um projeto do GlitchTip,
# com o host interno (http://<chave>@glitchtip:8000/<id>).
SENTRY_DSN=
# local: Lighthouse CI em container (relatórios no LHCI server do perfil lighthouse); psi em produção.
LIGHTHOUSE_PROVIDER=local
