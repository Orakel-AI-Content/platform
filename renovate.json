{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Minor e patch fora do caminho crítico num PR só por semana",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "dependências (minor/patch)"
    },
    {
      "description": "Next.js e React: PR próprio e sem espera (críticas em até 48 h, ADR 0002)",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "next e react",
      "schedule": ["at any time"],
      "minimumReleaseAge": null
    },
    {
      "description": "TypeScript 7 só quando o typescript-eslint suportar (TS 7.1)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
